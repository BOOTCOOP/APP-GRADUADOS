# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

graduados-app.code-workspace

# Firma Android: keystores y credenciales JAMÁS entran al repo,
# en ninguna ubicación (raíz, android/, android/app/...).
keystore.properties
*.jks
*.keystore

# Artefactos de build nativo: los AAB/APK que se bajan de Actions para
# subir a las tiendas pesan decenas de MB y no van al historial.
*.aab
*.apk

# Zips OTA recién generados por make-bundle.js: quedan en la raíz y son
# transitorios (van a un GitHub Release). Anclado a la raíz a propósito: por la
# vía alternativa de Pages, los bundles de public/ota/ SÍ se commitean.
/bundle-*.zip

# fastlane: solo se versionan el Fastfile y las notas de la tienda; el resto
# son artefactos de cada corrida.
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/screenshots
fastlane/test_output

.claude
.agents